%% ST-101 Ingestion — strategy chain resolution
%% For each of the two sources, walk the ordered chain.
%% Outcome is decided by CONTENT, not by status code.
%% Chains verified by probe on 2026-09-29; see api/external-api.yaml
flowchart TD
    START([POST /v1/people/id/ingest]) --> GUARD{Already ingested<br/>and force=false?}
    GUARD -->|Yes| EARLY[Return 200 immediately<br/>no outbound request]
    GUARD -->|No| SEM

    SEM[[httpx Semaphore 4<br/>render Semaphore 2]] --> CHAIN

    subgraph LINKEDIN["Source: linkedin — 3 strategies"]
        CHAIN --> L1{li_jina_reader<br/>Bearer $JINA_API_KEY}
        L1 -->|no key set| LSKIP[record: skipped,<br/>no key] --> L2
        L1 -->|200 with 2k+ chars<br/>and a section heading| LOK[success]
        L1 -->|403 Cloudflare<br/>challenge| L2{li_direct}
        L2 -->|HTTP 999 bot block| L3{li_browser_render}
        L2 -->|200 with profile<br/>headings| LOK
        L3 -->|200 but<br/>'Sign Up | LinkedIn'| LFAIL[failure: blocked]
    end

    subgraph INSTAGRAM["Source: instagram — 4 strategies"]
        CHAIN --> I1{ig_browser_render<br/>Playwright + host Chromium}
        I1 -->|200, hydrated:<br/>biography + full_name + followers| IOK[success]
        I1 -->|no biography and<br/>no full_name| I2{ig_web_profile_info<br/>x-ig-app-id header}
        I1 -->|timeout / launch error| I2
        I2 -->|200 with data.user| IOK
        I2 -->|429| IBACK[[tenacity backoff<br/>max 3 attempts]]
        IBACK --> I2
        IBACK -->|exhausted| I3{ig_embed}
        I2 -->|404 private/absent| I3
        I3 -->|200 with og:description| IOK
        I3 -->|shell only, no data| I4{ig_jina_reader}
        I4 -->|200 with content| IOK
        I4 -->|login wall| IFAIL[failure: blocked]
    end

    LOK --> SAN
    IOK --> SAN

    SAN[Sanitise: strip HTML, remove<br/>zero-width chars, neutralise<br/>instruction framing, truncate 8k] --> RECORD

    LFAIL --> RECORD
    IFAIL --> RECORD
    LSKIP --> RECORD

    RECORD[Write source_profiles row<br/>ALWAYS — even on failure.<br/>winning_strategy, http_status,<br/>duration, failure_reason]

    RECORD --> DERIVE{Derive ingest_state}
    DERIVE -->|both success| ING[ingested]
    DERIVE -->|exactly one success| PART[partial]
    DERIVE -->|both failed| FAILED[failed]

    ING --> LOG[append to ingest_runs.strategy_log]
    PART --> LOG
    FAILED --> LOG

    LOG --> RESP([200 OK with ingest_state<br/>NEVER a 5xx for upstream failure])

    style LFAIL fill:#ffd6d6
    style IFAIL fill:#ffd6d6
    style LSKIP fill:#fff3cd
    style PART fill:#fff3cd
    style ING fill:#d4edda
    style FAILED fill:#f8d7da
    style SAN fill:#cce5ff
    style I1 fill:#d4edda
    style RESP fill:#d4edda
